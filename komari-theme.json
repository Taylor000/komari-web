{
  "name": "Komari",
  "short": "default",
  "description": "Komari 自定义主题",
  "version": "1.0.0",
  "author": "Akizon77",
  "url": "https://github.com/komari-monitor/komari-web",
  "preview": "dist/assets/edit_117847723_p0.png",
  "configuration": {
    "type": "managed",
    "name": {
      "zh-CN": "主题设置"
    },
    "data": [
      {
        "name": {
          "zh-CN": "通用设置"
        },
        "type": "title"
      },
      {
        "key": "showIpTagsInCard",
        "name": {
          "zh-CN": "在卡片中显示IP标签"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "开启以在首页服务器列表中显示IPv4/IPv6标签，需要在设置中开启向访客显示部分IP地址功能。"
        }
      },
      {
        "key": "showLifetimeInCard",
        "name": {
          "zh-CN": "显示存续时长"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "在服务器卡片和详情页显示从购买到现在的时长（不受重启影响）。购买时间在后台「编辑信息」或「账单」中设置。"
        }
      },
      {
        "key": "lifetimeFallbackToCreatedAt",
        "name": {
          "zh-CN": "未设置购买时间时按加入面板时间计算存续"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "关闭后，只有在后台设置了购买时间的服务器才会显示存续时长。"
        }
      },
      {
        "key": "showServerListInDetails",
        "default": true,
        "type": "switch",
        "name": {
          "zh-CN": "在详情页显示服务器列表"
        },
        "help": {
          "zh-CN": "开启以在每个服务器的详情页中显示服务器列表，方便用户无需返回首页即可轻松导航到其他服务器。"
        }
      },
      {
        "key": "backgroundImageUrlDesktop",
        "type": "string",
        "default": "",
        "name": {
          "zh-CN": "背景图片URL（桌面端）"
        },
        "help": {
          "zh-CN": "为桌面端首页设置自定义背景图片。"
        }
      },
      {
        "key": "backgroundImageUrlMobile",
        "type": "string",
        "default": "",
        "name": {
          "zh-CN": "背景图片URL（移动端）"
        },
        "help": {
          "zh-CN": "为移动端首页设置自定义背景图片。如果为空，将使用桌面端背景。"
        }
      },
      {
        "key": "customFooterHtml",
        "type": "richtext",
        "name": {
          "zh-CN": "自定义页脚HTML"
        },
        "help": {
          "zh-CN": "设置自定义页脚HTML内容以替代构建和版本信息。"
        },
        "default": ""
      },
      {
        "key": "mainContentWidth",
        "type": "number",
        "name": {
          "zh-CN": "主要内容宽度"
        },
        "help": {
          "zh-CN": "调整主要内容的最大宽度，单位为视口宽度的百分比（vw）。设置为100以使用全宽。"
        },
        "default": 100
      }
    ]
  }
}
